#![enable(unwrap_newtypes)]
#![enable(implicit_some)]
#![enable(unwrap_variant_newtypes)]
(
    version: 1,
    name: "Agent study / Amber helmet surface",
    values: (
        base_color: (1.0, 0.45, 0.15, 1.0),
        metallic: 0.6,
        roughness: 0.65,
        ao: 1.0,
        emissive_factor: (3.0, 0.2, 0.03),
        normal_scale: 0.5,
        occlusion_strength: 0.7,
        alpha_mode: opaque,
        alpha_cutoff: 0.5,
        double_sided: false,
    ),
    sampling: (
        albedo: (
            uv: (
                tex_coord: 0,
                offset: (0.1, 0.0),
                rotation: 0.2,
                scale: (1.5, 1.5),
            ),
            sampler: (
                min_filter: linear,
                mag_filter: linear,
                mip_filter: linear,
                address_u: repeat,
                address_v: repeat,
                address_w: repeat,
                comparison: None,
                anisotropy: 1,
            ),
        ),
        normal: (
            uv: (
                tex_coord: 0,
                offset: (0.0, 0.0),
                rotation: 0.0,
                scale: (1.0, 1.0),
            ),
            sampler: (
                min_filter: linear,
                mag_filter: linear,
                mip_filter: linear,
                address_u: repeat,
                address_v: repeat,
                address_w: repeat,
                comparison: None,
                anisotropy: 1,
            ),
        ),
        metallic_roughness: (
            uv: (
                tex_coord: 0,
                offset: (0.0, 0.0),
                rotation: 0.0,
                scale: (1.0, 1.0),
            ),
            sampler: (
                min_filter: linear,
                mag_filter: linear,
                mip_filter: linear,
                address_u: repeat,
                address_v: repeat,
                address_w: repeat,
                comparison: None,
                anisotropy: 1,
            ),
        ),
        occlusion: (
            uv: (
                tex_coord: 0,
                offset: (0.0, 0.0),
                rotation: 0.0,
                scale: (1.0, 1.0),
            ),
            sampler: (
                min_filter: linear,
                mag_filter: linear,
                mip_filter: linear,
                address_u: repeat,
                address_v: repeat,
                address_w: repeat,
                comparison: None,
                anisotropy: 1,
            ),
        ),
        emission: (
            uv: (
                tex_coord: 0,
                offset: (0.0, 0.0),
                rotation: 0.0,
                scale: (1.0, 1.0),
            ),
            sampler: (
                min_filter: linear,
                mag_filter: linear,
                mip_filter: linear,
                address_u: repeat,
                address_v: repeat,
                address_w: repeat,
                comparison: None,
                anisotropy: 1,
            ),
        ),
    ),
    textures: (
        albedo: (
            kind: "gltf_image",
            asset: Resource("models/DamagedHelmet.glb"),
            image_index: 0,
        ),
        normal: (
            kind: "gltf_image",
            asset: Resource("models/DamagedHelmet.glb"),
            image_index: 4,
        ),
        metallic_roughness: (
            kind: "gltf_image",
            asset: Resource("models/DamagedHelmet.glb"),
            image_index: 1,
        ),
        occlusion: (
            kind: "gltf_image",
            asset: Resource("models/DamagedHelmet.glb"),
            image_index: 3,
        ),
        emission: (
            kind: "gltf_image",
            asset: Resource("models/DamagedHelmet.glb"),
            image_index: 2,
        ),
    ),
)