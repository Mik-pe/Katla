#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Data { uint values[]; } data;
layout(set = 0, binding = 1, std140) uniform Params { uvec4 values; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    data.values[i] = data.values[i] * params.values.x + params.values.y;
}
