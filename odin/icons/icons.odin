// Katla icon codepoints. A matching icon font is supplied by the UI consumer.
package katla_icons

/// Named icon value used by catalogue consumers.
Icon :: struct { name: string, codepoint: rune }

/// ForkAwesome home codepoint.
HOME :: rune(0xF015)
/// ForkAwesome search codepoint.
SEARCH :: rune(0xF002)
